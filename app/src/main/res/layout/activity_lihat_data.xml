<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/title_choose_category"
            app:titleCentered="true"
            app:titleTextColor="@color/header_text_color"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/header_text_color" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="32dp"
            android:src="@drawable/ic_app_logo"
            android:alpha="0.8"
            android:contentDescription="Icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/header_manajemen_vaksin"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/subtitle_choose_data"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJadwalVaksin"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_jadwal_vaksinasi"
            android:textColor="@color/primary_green"
            android:textSize="15sp"
            android:stateListAnimator="@animator/button_press_scale"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_menu_today"
            app:iconPadding="12dp"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemVaksin"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_stok_item_vaksin"
            android:textColor="@color/primary_green"
            android:textSize="15sp"
            android:stateListAnimator="@animator/button_press_scale"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconPadding="12dp"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistoryTernak"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/btn_history_ternak"
            android:textColor="@color/primary_green"
            android:textSize="15sp"
            android:stateListAnimator="@animator/button_press_scale"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:iconPadding="12dp"
            app:iconSize="24dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>